# Envío de correos con Gmail (Nodemailer)
# GMAIL_USER: la cuenta de Gmail que envía los correos.
# GMAIL_APP_PASSWORD: "Contraseña de aplicación" generada en
#   https://myaccount.google.com/apppasswords (requiere verificación en
#   2 pasos activada en esa cuenta de Google). NO uses la contraseña normal.
GMAIL_USER=tomatocostarica@gmail.com
GMAIL_APP_PASSWORD=

# Correos de destino
CONTACT_EMAIL=tomatocostarica@gmail.com
REPORTS_EMAIL=tomatocostarica@gmail.com

# Login del cotizador (usuario/contraseña reales, no los dejes en el código)
AUTH_USER=
AUTH_PASS=
# Cadena larga y aleatoria para firmar los tokens de sesión, ej: openssl rand -hex 32
AUTH_SECRET=

# Servidor
PORT=3000
NODE_ENV=production
